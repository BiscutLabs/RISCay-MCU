+// The corrected accounting is limited to uniform physical-module regions.
+// Power domains and mixed-site rows retain upstream behavior: this experiment
+// does not qualify power-domain insertion or legalizer ownership of new cells.
+static bool uniformPhysicalRegions(odb::dbBlock* block)
+{
+  bool found = false;
+  for (auto* group : block->getGroups()) {
+    if (group->getRegion()) {
+      if (group->getType() != odb::dbGroupType::PHYSICAL_CLUSTER
+          || group->getRegion()->getBoundaries().size() != 1) {
+        return false;
+      }
+      found = true;
+    }
+  }
+  if (!found) {
+    return false;
+  }
+  odb::dbSite* site = nullptr;
+  odb::Point origin;
+  for (auto* row : block->getRows()) {
+    if (site == nullptr) {
+      site = row->getSite();
+      origin = row->getOrigin();
+    }
+    const odb::Point point = row->getOrigin();
+    if (site->getWidth() <= 0 || site->getHeight() <= 0
+        || row->getSite() != site
+        || row->getDirection() != odb::dbRowDir::HORIZONTAL
+        || row->getSpacing() != site->getWidth()
+        || (point.x() - origin.x()) % site->getWidth() != 0
+        || (point.y() - origin.y()) % site->getHeight() != 0) {
+      return false;
+    }
+  }
+  return site != nullptr;
+}
